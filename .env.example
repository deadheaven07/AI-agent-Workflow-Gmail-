# ==========================================
# 3-Agent Personal Executive Suite - Config
# ==========================================

# 1. Google Gemini API (100% Free Tier from Google AI Studio)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_ge
GEMINI_MODEL=gemini-2.5-flash

# 2. Telegram Bot Alerts (100% Free Mobile Alerts)
# Step 1: Message @BotFather on Telegram to create a bot and get your BOT TOKEN
# Step 2: Message your bot or @userinfobot to get your numeric CHAT ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 3. Email Triage Agent (IMAP Access)
# For Gmail: Use 'imap.gmail.com' and create an App Password (do NOT use your main Gmail password).
# How to get a Gmail App Password:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create a new App Password named 'Executive Suite' and paste the 16-character code below.
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_16_char_app_password

# 4. User Preferences & Skills for Freelance Matching (Comma-separated)
USER_SKILLS=Python,React,FastAPI,Web Scraping,AI Agents,Streamlit

# 5. Default Stock Portfolio (JSON format)
STOCK_HOLDINGS=[{"ticker": "AAPL", "buy_price": 170.0, "qty": 10}, {"ticker": "NVDA", "buy_price": 110.0, "qty": 15}, {"ticker": "MSFT", "buy_price": 400.0, "qty": 5}]
